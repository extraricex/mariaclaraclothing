PORT=3000
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/maria_clara_webstore
ADMIN_TOKEN=change-this-admin-token
ADMIN_PASSWORD=change-this-admin-password
CUSTOMER_AUTH_SECRET=replace-with-at-least-32-random-characters
PANCAKE_MODE=disabled
PANCAKE_API_BASE_URL=https://pos.pages.fm/api/v1
PANCAKE_API_KEY=
PANCAKE_SHOP_ID=
PANCAKE_WAREHOUSE_ID=
PANCAKE_ORDER_SOURCE_ID=
PANCAKE_WEBHOOK_SECRET=
PANCAKE_REQUEST_TIMEOUT_MS=20000
PANCAKE_CATALOG_PAGE_SIZE=100
PANCAKE_CATALOG_MAX_PAGES=100
PANCAKE_AUTO_SYNC_ENABLED=
PANCAKE_AUTO_SYNC_INTERVAL_MS=600000
PANCAKE_AUTO_SYNC_STARTUP_DELAY_MS=15000
PANCAKE_ORDER_POLL_INTERVAL_MS=300000
PANCAKE_ORDER_POLL_PAGE_SIZE=50
PANCAKE_ORDER_POLL_LOOKBACK_MS=900000
PANCAKE_SYNC_MAX_ATTEMPTS=10
CHECKOUT_V2_REQUIRED=true
ORDER_CONFIRMATION_SECRET=replace-with-at-least-32-random-characters
REVIEW_IMPORT_SECRET=replace-with-another-32-plus-character-random-secret
META_CONVERSIONS_API_ENABLED=false
META_PIXEL_ID=595813035761213
META_CONVERSIONS_API_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_CONVERSIONS_API_TEST_EVENT_CODE=

# Delivered-order confirmation notifications. Both providers remain inactive
# until enabled and their server-side credentials are supplied.
ORDER_NOTIFICATIONS_ENABLED=false
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
RESEND_API_KEY=
ORDER_NOTIFICATION_FROM_EMAIL=Maria Clara Clothing <orders@example.com>

# J&T Philippines stays in dry-run until official VIP API access and specs exist.
JNT_INTEGRATION_MODE=dry_run
JNT_API_BASE_URL=
JNT_API_CUSTOMER_CODE=
JNT_API_KEY=

# Security hardening (all optional; sane defaults applied when unset)
# Set behind a reverse proxy (e.g. the Docker nginx) so per-client rate limiting
# works. Use the number of proxies to trust, e.g. 1.
TRUST_PROXY=
# Admin login throttle: max attempts per window (0 disables), window in ms.
ADMIN_LOGIN_RATE_LIMIT_MAX=50
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Checkout (POST /api/orders) throttle: max attempts per window (0 disables).
CHECKOUT_RATE_LIMIT_MAX=100
CHECKOUT_RATE_LIMIT_WINDOW_MS=600000
CUSTOMER_AUTH_RATE_LIMIT_MAX=30
CUSTOMER_AUTH_RATE_LIMIT_WINDOW_MS=900000
QUOTE_RATE_LIMIT_MAX=120
QUOTE_RATE_LIMIT_WINDOW_MS=600000
CART_RATE_LIMIT_MAX=180
CART_RATE_LIMIT_WINDOW_MS=600000
ORDER_LOOKUP_RATE_LIMIT_MAX=120
ORDER_LOOKUP_RATE_LIMIT_WINDOW_MS=600000
ADMIN_SENSITIVE_RATE_LIMIT_MAX=40
ADMIN_SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
ISSUE_REPORT_RATE_LIMIT_MAX=20
ISSUE_REPORT_RATE_LIMIT_WINDOW_MS=600000
REVIEW_SUBMISSION_RATE_LIMIT_MAX=8
REVIEW_SUBMISSION_RATE_LIMIT_WINDOW_MS=3600000
ISSUE_UPLOAD_DIR=./private-uploads/issues
