mariaclaraclothing.com {
	encode zstd gzip
	@admin_path path /admin /admin/*
	respond @admin_path 404
	reverse_proxy 127.0.0.1:8081 {
		# Hold a request briefly while the single web container is handed over.
		# Failed connections are safe to retry and normal traffic is unaffected.
		lb_try_duration 5s
		lb_try_interval 100ms
	}
}

www.mariaclaraclothing.com {
	redir https://mariaclaraclothing.com{uri} permanent
}

admin.mariaclaraclothing.com {
	encode zstd gzip
	@root path /
	redir @root /admin 302
	reverse_proxy 127.0.0.1:8081 {
		lb_try_duration 5s
		lb_try_interval 100ms
	}
}
