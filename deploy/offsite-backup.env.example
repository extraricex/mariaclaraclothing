# Copy to /home/deploy/.config/mariaclara/offsite-backup.env on the VPS.
# chmod 600 this file. Never commit the real file or application key.
RESTIC_REPOSITORY=b2:YOUR_PRIVATE_BUCKET:mariaclara-production
RESTIC_PASSWORD_FILE=/home/deploy/.config/mariaclara/restic-password
B2_ACCOUNT_ID=YOUR_BUCKET_SCOPED_APPLICATION_KEY_ID
B2_ACCOUNT_KEY=YOUR_BUCKET_SCOPED_APPLICATION_KEY
