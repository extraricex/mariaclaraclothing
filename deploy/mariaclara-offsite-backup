#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CONFIG_FILE=${MARIACLARA_OFFSITE_CONFIG:-/home/deploy/.config/mariaclara/offsite-backup.env}
BACKUP_DIR=${MARIACLARA_BACKUP_DIR:-/var/backups/mariaclara}

if [[ ! -r "$CONFIG_FILE" ]]; then
  echo "Off-site backup configuration is missing: $CONFIG_FILE" >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$CONFIG_FILE"
: "${RESTIC_REPOSITORY:?RESTIC_REPOSITORY is required}"
: "${RESTIC_PASSWORD_FILE:?RESTIC_PASSWORD_FILE is required}"
: "${B2_ACCOUNT_ID:?B2_ACCOUNT_ID is required}"
: "${B2_ACCOUNT_KEY:?B2_ACCOUNT_KEY is required}"

test -r "$RESTIC_PASSWORD_FILE"
test -d "$BACKUP_DIR"

restic backup "$BACKUP_DIR" --host mariaclara-production --tag automated
restic forget --host mariaclara-production --tag automated \
  --keep-daily 14 --keep-weekly 8 --keep-monthly 6 --prune
