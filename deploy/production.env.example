# Copy to deploy/production.env on the server. Do not commit deploy/production.env.
#
# Generate secrets:
#   openssl rand -hex 32

# Public port exposed by the web container.
# Recommended with Caddy on the VPS: bind only to localhost and let Caddy handle HTTPS.
HTTP_PORT=127.0.0.1:8081

# PostgreSQL service.
POSTGRES_DB=maria_clara
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgres://postgres:replace-with-strong-postgres-password@postgres:5432/maria_clara

# API runtime.
APP_ENV=production
PORT=3000
# Caddy -> Docker nginx -> Express is two trusted proxy hops. Use 1 only when
# Docker nginx is the sole proxy in front of the API.
TRUST_PROXY=2
CHECKOUT_V2_REQUIRED=true
ORDER_CONFIRMATION_SECRET=replace-with-64-random-hex-characters
CUSTOMER_AUTH_SECRET=replace-with-64-random-hex-characters
AUTH_SECRET=replace-with-the-same-customer-auth-secret
ADMIN_TOKEN=replace-with-64-random-hex-characters
ADMIN_PASSWORD=replace-with-strong-admin-password

# Customer OAuth. Register the exact callback URLs documented in DEPLOYMENT_GUIDE.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
AUTH_CALLBACK_URL=https://mariaclaraclothing.com/api/customer/oauth
FRONTEND_URL=https://mariaclaraclothing.com

# Pancake POS. Keep writes disabled for the first deploy. Follow the staged
# read_only -> shadow -> live procedure in DEPLOYMENT_GUIDE.md.
PANCAKE_MODE=disabled
PANCAKE_API_BASE_URL=https://pos.pages.fm/api/v1
PANCAKE_API_KEY=replace-with-pancake-api-key
PANCAKE_SHOP_ID=replace-with-pancake-shop-id
PANCAKE_WAREHOUSE_ID=replace-with-pancake-warehouse-id
PANCAKE_ORDER_SOURCE_ID=replace-with-pancake-order-source-id
# Pancake order webhook: https://mariaclaraclothing.com/api/integrations/pancake/webhook
# Configure request header X-Maria-Clara-Pancake-Secret with this same value.
PANCAKE_WEBHOOK_SECRET=
PANCAKE_REQUEST_TIMEOUT_MS=20000
PANCAKE_CATALOG_PAGE_SIZE=100
PANCAKE_CATALOG_MAX_PAGES=100
PANCAKE_AUTO_SYNC_ENABLED=false
PANCAKE_AUTO_SYNC_INTERVAL_MS=
PANCAKE_SYNC_ENABLED=false
PANCAKE_SYNC_INTERVAL_MINUTES=3
PANCAKE_AUTO_SYNC_STARTUP_DELAY_MS=15000
PANCAKE_ORDER_POLL_INTERVAL_MS=300000
PANCAKE_ORDER_POLL_PAGE_SIZE=50
PANCAKE_ORDER_POLL_LOOKBACK_MS=900000
PANCAKE_SYNC_MAX_ATTEMPTS=10
# Required before PANCAKE_MODE=live. Record the production cutover instant in UTC.
PANCAKE_ORDER_EXPORT_CUTOFF_AT=

# PayMongo V2 Hosted Checkout. Register the signed webhook at /api/payments/paymongo/webhook.
PAYMONGO_ENABLED=false
PAYMONGO_API_BASE_URL=https://api.paymongo.com
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_SUCCESS_URL=https://mariaclaraclothing.com/thank-you
PAYMONGO_CANCEL_URL=https://mariaclaraclothing.com/checkout
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,paymaya,qrph
PAYMONGO_RESERVATION_MINUTES=30

# Meta browser pixel and optional server CAPI.
VITE_FACEBOOK_META_PIXEL_ENABLED=true
VITE_FACEBOOK_META_PIXEL_ID=595813035761213
META_CONVERSIONS_API_ENABLED=false
META_PIXEL_ID=595813035761213
META_CONVERSIONS_API_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_CONVERSIONS_API_TEST_EVENT_CODE=

# Delivered-order SMS/email notifications. Keep disabled until credentials are live.
ORDER_NOTIFICATIONS_ENABLED=false
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
RESEND_API_KEY=
ORDER_NOTIFICATION_FROM_EMAIL=Maria Clara Clothing <orders@example.com>

# J&T remains dry-run until official production API access is available.
JNT_INTEGRATION_MODE=dry_run
JNT_API_BASE_URL=
JNT_API_CUSTOMER_CODE=
JNT_API_KEY=

# Rate limits.
ADMIN_LOGIN_RATE_LIMIT_MAX=50
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
CHECKOUT_RATE_LIMIT_MAX=100
CHECKOUT_RATE_LIMIT_WINDOW_MS=600000
CUSTOMER_AUTH_RATE_LIMIT_MAX=30
CUSTOMER_AUTH_RATE_LIMIT_WINDOW_MS=900000
CUSTOMER_OAUTH_RATE_LIMIT_MAX=60
CUSTOMER_OAUTH_RATE_LIMIT_WINDOW_MS=900000
QUOTE_RATE_LIMIT_MAX=120
QUOTE_RATE_LIMIT_WINDOW_MS=600000
CART_RATE_LIMIT_MAX=180
CART_RATE_LIMIT_WINDOW_MS=600000
ORDER_LOOKUP_RATE_LIMIT_MAX=120
ORDER_LOOKUP_RATE_LIMIT_WINDOW_MS=600000
ADMIN_SENSITIVE_RATE_LIMIT_MAX=40
ADMIN_SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
ISSUE_REPORT_RATE_LIMIT_MAX=20
ISSUE_REPORT_RATE_LIMIT_WINDOW_MS=600000
