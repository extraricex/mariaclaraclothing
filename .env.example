# Maria Clara Clothing environment variable reference.
#
# Local Docker:
#   cp .env.example .env
#   Change APP_ENV to development and TRUST_PROXY to 1.
#
# Production VPS:
#   cp deploy/production.env.example deploy/production.env
#   Follow DEPLOYMENT_GUIDE.md. The deploy template is authoritative for the
#   production Compose stack.
#
# Never commit .env, deploy/production.env, provider keys, or passwords.

# Public web binding. Keep this on localhost when host Caddy terminates HTTPS.
HTTP_PORT=127.0.0.1:8081

# PostgreSQL. POSTGRES_PASSWORD must match the password inside DATABASE_URL.
# A hex password from `openssl rand -hex 32` is URL-safe.
POSTGRES_DB=maria_clara
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
DATABASE_URL=postgres://postgres:replace-with-the-same-64-random-hex-characters@postgres:5432/maria_clara

# Required production API configuration.
APP_ENV=production
PORT=3000
# Caddy -> Docker nginx -> Express is two proxy hops. Local Docker uses 1.
TRUST_PROXY=2
CHECKOUT_V2_REQUIRED=true
ORDER_CONFIRMATION_SECRET=replace-with-a-unique-64-character-random-secret
CUSTOMER_AUTH_SECRET=replace-with-a-different-64-character-random-secret
ADMIN_TOKEN=replace-with-a-different-64-character-random-secret
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password

# Customer OAuth. Secrets remain server-side. Provider buttons stay hidden until
# both credentials for that provider are set and the admin setting is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
AUTH_CALLBACK_URL=https://mariaclaraclothing.com/api/customer/oauth
FRONTEND_URL=https://mariaclaraclothing.com

# Pancake POS. Safe first-deploy defaults perform no background sync or writes.
# Follow the read_only -> shadow -> live rollout in DEPLOYMENT_GUIDE.md.
PANCAKE_MODE=disabled
PANCAKE_API_BASE_URL=https://pos.pages.fm/api/v1
PANCAKE_API_KEY=
PANCAKE_SHOP_ID=
PANCAKE_WAREHOUSE_ID=
PANCAKE_ORDER_SOURCE_ID=
# Configure Pancake to POST order webhooks to:
# https://mariaclaraclothing.com/api/integrations/pancake/webhook
# Add request header X-Maria-Clara-Pancake-Secret with this same strong value.
PANCAKE_WEBHOOK_SECRET=
PANCAKE_REQUEST_TIMEOUT_MS=20000
PANCAKE_CATALOG_PAGE_SIZE=100
PANCAKE_CATALOG_MAX_PAGES=100
PANCAKE_AUTO_SYNC_ENABLED=false
PANCAKE_AUTO_SYNC_INTERVAL_MS=600000
PANCAKE_AUTO_SYNC_STARTUP_DELAY_MS=15000
PANCAKE_ORDER_POLL_INTERVAL_MS=300000
PANCAKE_ORDER_POLL_PAGE_SIZE=50
PANCAKE_ORDER_POLL_LOOKBACK_MS=900000
PANCAKE_SYNC_MAX_ATTEMPTS=10
# Required before PANCAKE_MODE=live. Only orders placed at/after this UTC instant can be backfilled.
PANCAKE_ORDER_EXPORT_CUTOFF_AT=

# Browser Meta Pixel values are public and are baked into the web build.
VITE_FACEBOOK_META_PIXEL_ENABLED=true
VITE_FACEBOOK_META_PIXEL_ID=595813035761213

# Optional server-side Meta Conversions API. Leave disabled until configured.
META_CONVERSIONS_API_ENABLED=false
META_PIXEL_ID=595813035761213
META_CONVERSIONS_API_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_CONVERSIONS_API_TEST_EVENT_CODE=

# Optional delivered-order SMS/email notifications.
ORDER_NOTIFICATIONS_ENABLED=false
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
RESEND_API_KEY=
ORDER_NOTIFICATION_FROM_EMAIL=Maria Clara Clothing <orders@example.com>

# J&T live booking is not implemented. Production must remain dry_run.
JNT_INTEGRATION_MODE=dry_run
JNT_API_BASE_URL=
JNT_API_CUSTOMER_CODE=
JNT_API_KEY=

# Per-process rate limits. A value of 0 disables the corresponding limiter.
ADMIN_LOGIN_RATE_LIMIT_MAX=50
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
CHECKOUT_RATE_LIMIT_MAX=100
CHECKOUT_RATE_LIMIT_WINDOW_MS=600000
CUSTOMER_AUTH_RATE_LIMIT_MAX=30
CUSTOMER_AUTH_RATE_LIMIT_WINDOW_MS=900000
CUSTOMER_OAUTH_RATE_LIMIT_MAX=60
CUSTOMER_OAUTH_RATE_LIMIT_WINDOW_MS=900000
QUOTE_RATE_LIMIT_MAX=120
QUOTE_RATE_LIMIT_WINDOW_MS=600000
CART_RATE_LIMIT_MAX=180
CART_RATE_LIMIT_WINDOW_MS=600000
ORDER_LOOKUP_RATE_LIMIT_MAX=120
ORDER_LOOKUP_RATE_LIMIT_WINDOW_MS=600000
ADMIN_SENSITIVE_RATE_LIMIT_MAX=40
ADMIN_SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
ISSUE_REPORT_RATE_LIMIT_MAX=20
ISSUE_REPORT_RATE_LIMIT_WINDOW_MS=600000
ISSUE_UPLOAD_DIR=./apps/api/private-uploads/issues

# Do not set JSON data-file or upload-directory overrides in production.
